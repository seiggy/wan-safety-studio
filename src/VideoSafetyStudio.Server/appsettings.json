{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Storage": { "Backend": "local" },
  "Generation": { "Provider": "azureml" },
  "AzureMl": {
    "Datastore": "workspaceblobstore",
    "Armed": false,
    "PollSeconds": 5,
    "MaxConcurrency": 25,
    "MaxJobMinutes": 120,
    "MaxUploadMb": 64
  },
  "Auth": { "ClientId": "", "PublicOrigin": "" },
  "ComfyUi": { "Url": "http://localhost:8188", "Retrieval": "api" },
  "Trainers": { "BuiltIn": "../../trainers" }
}
