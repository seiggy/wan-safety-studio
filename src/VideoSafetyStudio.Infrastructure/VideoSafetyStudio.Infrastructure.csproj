<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\VideoSafetyStudio.Application\VideoSafetyStudio.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Microsoft.Agents.AI.GitHub.Copilot" Version="1.23.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Copilot SDK downloads its CLI at build time; route that through the single approved feed. -->
    <CopilotNpmRegistryUrl>https://packagefeedproxy.microsoft.io/npm</CopilotNpmRegistryUrl>
    <!-- Provider.BearerTokenProvider (Entra auth for Foundry) is marked experimental in the Copilot SDK. -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

</Project>

